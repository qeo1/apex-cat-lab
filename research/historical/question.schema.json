{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apex-cat-lab.invalid/research/historical/question.schema.json",
  "title": "Historical CAT question evidence record",
  "type": "object",
  "required": ["id", "paper_id", "year", "slot", "section", "question_number", "source_ids", "source_urls", "authenticity_grade", "retrieval_state", "reasoning_fingerprint", "answer_state", "rights_status"],
  "properties": {
    "id": {"type": "string", "pattern": "^CAT-[0-9]{4}-(S[0-9]+|PAPER)-(VARC|DILR|QA)-Q[0-9]+$"},
    "paper_id": {"type": "string"},
    "legacy_id": {"type": ["string", "null"]},
    "year": {"type": "integer", "minimum": 1990},
    "slot": {"type": ["integer", "null"], "minimum": 1},
    "section": {"enum": ["VARC", "DILR", "QA"]},
    "question_number": {"type": "integer", "minimum": 1},
    "set_id": {"type": ["string", "null"]},
    "passage_id": {"type": ["string", "null"]},
    "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "source_locators": {"description": "Preserve each archive's own item/set/passage numbering; do not normalize away disagreements.", "type": "array", "items": {"type": "object", "required": ["source_id", "locator"], "properties": {"source_id": {"type": "string"}, "locator": {"type": "string"}, "note": {"type": "string"}}, "additionalProperties": false}},
    "retrieved_on": {"type": "string", "format": "date"},
    "authenticity_grade": {"enum": ["A", "B", "C", "D", "E"]},
    "retrieval_state": {"enum": ["source_located", "question_retrieved", "question_audited", "paper_partial", "paper_complete"]},
    "format": {"enum": ["MCQ", "TITA", "unknown"]},
    "topic": {"type": ["string", "null"]},
    "subtopic": {"type": ["string", "null"]},
    "reasoning_fingerprint": {"type": "string", "minLength": 20},
    "forensic_analysis": {
      "description": "Populate only after direct inspection of the actual question; unknown dimensions remain absent or null.",
      "type": "object",
      "properties": {
        "conceptual_architecture": {"type": "object", "properties": {"primary_concepts": {"type": "array", "items": {"type": "string"}}, "secondary_concepts": {"type": "array", "items": {"type": "string"}}, "prerequisites": {"type": "array", "items": {"type": "string"}}, "hidden_relationships": {"type": "array", "items": {"type": "string"}}, "required_representation": {"type": ["string", "null"]}, "assumptions": {"type": "array", "items": {"type": "string"}}, "interacting_constraints": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
        "reasoning_sequence": {"type": "array", "items": {"type": "string"}},
        "solution_architecture": {"type": "object", "properties": {"obvious_approach": {"type": ["string", "null"]}, "efficient_valid_approach": {"type": ["string", "null"]}, "critical_insight": {"type": ["string", "null"]}, "sticking_point": {"type": ["string", "null"]}, "alternate_paths": {"type": "array", "items": {"type": "string"}}, "computational_burden": {"type": ["string", "null"]}, "avoidable_work": {"type": ["string", "null"]}}, "additionalProperties": false},
        "construction_architecture": {"type": "object", "properties": {"given_information": {"type": "array", "items": {"type": "string"}}, "inferred_information": {"type": "array", "items": {"type": "string"}}, "dependency_structure": {"type": "string"}, "legitimate_ambiguities": {"type": "array", "items": {"type": "string"}}, "difficulty_mechanism": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
        "difficulty_evidence": {"type": "object", "properties": {"conceptual_novelty": {"type": ["string", "null"]}, "reasoning_stages": {"type": ["integer", "null"], "minimum": 0}, "constraint_interactions": {"type": ["string", "null"]}, "representation_difficulty": {"type": ["string", "null"]}, "calculation_burden": {"type": ["string", "null"]}, "time_pressure_estimate_minutes": {"type": ["number", "null"], "minimum": 0}, "trap_potential": {"type": ["string", "null"]}, "rating_basis": {"type": ["string", "null"]}}, "additionalProperties": false},
        "analysis_state": {"enum": ["not_started", "partial", "reviewed"]}
      },
      "additionalProperties": false
    },
    "core_insight": {"type": ["string", "null"]},
    "trap_architecture": {"type": ["string", "null"]},
    "source_answer": {"type": ["string", "null"]},
    "independent_answer": {"type": ["string", "null"]},
    "answer_state": {"enum": ["unchecked", "source_key_seen", "independently_verified", "conflict"]},
    "official_key_state": {"enum": ["not_found", "not_checked", "corroborated", "conflict"]},
    "difficulty": {"enum": ["unrated", "foundational", "easy", "moderate", "difficult", "very_difficult", "exceptional"]},
    "fingerprint_key": {"type": "string", "minLength": 8},
    "rights_status": {"enum": ["metadata_and_structural_summary_only", "permission_required", "unknown"]},
    "evidence_note": {"type": "string", "minLength": 10}
  },
  "additionalProperties": false
}

